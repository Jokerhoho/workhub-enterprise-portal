{
  "name": "workhub-enterprise-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "面向企业内部团队的 WorkBuddy 知识与工具门户",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vitepress dev docs --host 127.0.0.1",
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "test": "vitest run",
    "build": "vitepress build docs",
    "docs:build": "vitepress build docs",
    "preview": "vitepress preview docs --host 127.0.0.1",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "traffic:db:migrate:local": "wrangler d1 migrations apply TRAFFIC_DB --local",
    "traffic:db:seed:local": "wrangler d1 execute TRAFFIC_DB --local --file scripts/local-traffic-seed.sql",
    "traffic:setup:local": "npm run traffic:db:migrate:local && npm run traffic:db:seed:local",
    "traffic:collector:dev": "wrangler dev --config wrangler.collector.jsonc --test-scheduled",
    "pages:dev": "wrangler pages dev docs/.vitepress/dist --port 8788",
    "pages:deploy": "wrangler pages deploy docs/.vitepress/dist --project-name workbuddy-guide"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "mermaid": "11.16.0",
    "vitepress": "1.6.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
