{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workbuddy-traffic-collector",
  "main": "workers/traffic-collector.ts",
  "compatibility_date": "2026-08-07",
  "vars": {
    "TRAFFIC_SYNC_URL": "https://jokerhoho.github.io/workhub-enterprise-portal/api/internal/traffic-sync"
  },
  "triggers": {
    "crons": ["15 18 * * *"]
  }
}
